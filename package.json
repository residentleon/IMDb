{
  "name": "take_home_exercise",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "find-unused": "ts-prune",
    "find-unused-methods": "node --experimental-strip-types find-unused-methods.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:smoke:headed": "playwright test --grep @smoke --headed",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "chalk": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "ts-prune": "^0.10.3",
    "ts-unused-exports": "^11.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6"
  }
}
